<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Recipes | The Little Cup Cafe</title>
<script>
/* Visitor cookie choice: if ads were declined, ask Google for non-personalised ads only */
try{if(localStorage.getItem('tlcc-ads')==='declined'){(window.adsbygoogle=window.adsbygoogle||[]).requestNonPersonalizedAds=1}}catch(e){}

<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8241758030955235"
     crossorigin="anonymous"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#fff8fa;--surf:#fdeaf0;--ink:#3b2a3a;--soft:#6b5666;--pink:#f4c6d3;--accent:#a8335d;--sage:#d5e5d6;--sagedk:#46634e;--butter:#fbeab8;--lilac:#e2dbf3;
--serif:"Young Serif",Georgia,serif;--sans:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1d1520;--surf:#2a1f2d;--ink:#f7eaef;--soft:#c9b5c1;--pink:#5a3346;--accent:#f09cb8;--sage:#2c3b2f;--sagedk:#a9cdb0;--butter:#4a4126;--lilac:#352e4d}}
:root[data-theme="dark"]{--bg:#1d1520;--surf:#2a1f2d;--ink:#f7eaef;--soft:#c9b5c1;--pink:#5a3346;--accent:#f09cb8;--sage:#2c3b2f;--sagedk:#a9cdb0;--butter:#4a4126;--lilac:#352e4d}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.65 var(--sans)}
img{max-width:100%;display:block}
a{color:var(--accent)}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:4px}
.wrap{max-width:1040px;margin:0 auto;padding:0 22px}
header.top{display:flex;flex-wrap:wrap;gap:10px 28px;align-items:center;justify-content:space-between;padding:22px 0}
.brand{display:flex;align-items:center;gap:10px;font:400 1.3rem var(--serif);color:var(--ink);text-decoration:none}
.brand svg{width:34px;height:34px}
nav{display:flex;gap:22px;flex-wrap:wrap;font-weight:500}
nav a{color:var(--ink);text-decoration:none;border-bottom:2px solid transparent}
nav a:hover{border-color:var(--accent)}
h1,h2,h3{font-family:var(--serif);font-weight:400;line-height:1.15;margin:0}
.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding:30px 0 70px}
.hero h1{font-size:clamp(2.2rem,5.5vw,3.7rem);margin-bottom:18px}
.hero p{max-width:34em;color:var(--soft);font-size:1.1rem;margin:0 0 24px}
.btn{display:inline-block;background:var(--accent);color:#fff;padding:12px 24px;border-radius:99px;text-decoration:none;font-weight:700}
:root[data-theme="dark"] .btn,:root:not([data-theme="light"]) .btn{color:#2a1220}
.arch{border-radius:999px 999px 28px 28px;overflow:hidden;background:var(--pink);aspect-ratio:3/4;position:relative}
.arch img{width:100%;height:100%;object-fit:cover}
.heroimg{position:relative}
.heroimg .fl{position:absolute;width:74px;height:74px}
.fl.a{left:-18px;bottom:36px}.fl.b{right:-10px;top:30px;width:50px!important;height:50px!important}
h2.sec{font-size:1.9rem;margin:0 0 26px}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:40px 30px;padding-bottom:80px}
.card{display:block;text-decoration:none;color:inherit}
.card .arch{aspect-ratio:1/1;transition:transform .25s}
.card:hover .arch{transform:translateY(-4px)}
.tag{display:inline-block;font-size:.85rem;font-weight:700;padding:3px 12px;border-radius:99px;margin:16px 0 8px;color:var(--ink)}
.t0{background:var(--lilac)}.t1{background:var(--butter)}.t2{background:var(--sage)}.t3{background:var(--pink)}
.card h3{font-size:1.3rem;margin-bottom:6px}
.card p{margin:0;color:var(--soft);font-size:.98rem}
article{max-width:760px;margin:0 auto;padding:10px 0 70px}
.back{display:inline-block;margin:6px 0 22px;font-weight:500}
article h1{font-size:clamp(2rem,5vw,3rem);margin-bottom:14px}
.by{color:var(--soft);font-style:italic;margin:0 0 28px}
.lead{border-radius:28px;overflow:hidden;margin-bottom:30px;background:var(--pink)}
.lead img{width:100%;max-height:520px;object-fit:cover}
.duo{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:30px 0}
.duo img{border-radius:22px;width:100%;height:100%;object-fit:cover;aspect-ratio:4/5}
.tip{background:var(--butter);border-radius:20px;padding:18px 22px;margin:26px 0}
.tip b{font-family:var(--serif);font-weight:400}
.rec{background:var(--surf);border-radius:28px;padding:34px clamp(20px,5vw,44px);margin-top:36px}
.rec h2{font-size:2rem;margin-bottom:8px}
.rec h3{font-size:1.3rem;margin:26px 0 10px;color:var(--sagedk)}
.rec h2.sub{font-size:1.5rem;margin-top:34px;padding-top:26px;border-top:2px dotted var(--pink)}
.serves{color:var(--soft);margin:0 0 6px}
ul.ing{list-style:none;padding:0;margin:0}
ul.ing li{padding:9px 0 9px 30px;border-bottom:1px solid var(--pink);position:relative}
ul.ing li::before{content:"";position:absolute;left:4px;top:17px;width:11px;height:11px;border-radius:50%;background:var(--pink);box-shadow:inset 0 0 0 3px var(--surf)}
.method{counter-reset:s}
.method ol{list-style:none;padding:0;margin:0}
.method li{counter-increment:s;position:relative;padding:0 0 18px 52px}
.method li::before{content:counter(s);position:absolute;left:0;top:-2px;width:34px;height:34px;border-radius:50%;background:var(--sage);color:var(--ink);display:grid;place-items:center;font:400 1rem var(--serif)}
.sign{margin-top:40px;text-align:center;font-family:var(--serif)}
.sign svg{width:40px;height:40px}
.sign small{display:block;font:400 .95rem var(--sans);color:var(--soft)}
footer{background:var(--surf);padding:34px 0;text-align:center;color:var(--soft);font-size:.95rem}
footer svg{width:30px;height:30px}
@media (max-width:760px){.hero{grid-template-columns:1fr;padding-bottom:50px}.heroimg{max-width:380px;margin:0 auto;width:100%}.grid{grid-template-columns:1fr}.card .arch{aspect-ratio:1/1}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
.page p,.page li{color:var(--ink)}
.page h2{font-size:1.5rem;margin:34px 0 10px;color:var(--sagedk)}
.page ul{padding-left:22px}
.page .updated{color:var(--soft);font-style:italic;margin:0 0 24px}
.btnrow{display:flex;flex-wrap:wrap;gap:12px;margin:22px 0}
.btn.alt{background:var(--sage);color:var(--ink)}
.flinks{display:flex;flex-wrap:wrap;gap:8px 22px;justify-content:center;margin:0 0 14px;padding:0;list-style:none}
.flinks a,.flinks button{color:var(--ink);font:500 .95rem var(--sans);background:none;border:0;padding:0;cursor:pointer;text-decoration:underline}
#cc{position:fixed;left:0;right:0;bottom:0;z-index:50;background:var(--surf);border-top:2px solid var(--pink);padding:16px 22px calc(16px + env(safe-area-inset-bottom,0px));box-shadow:0 -6px 24px rgba(0,0,0,.08)}
#cc[hidden]{display:none}
#cc .in{max-width:1040px;margin:0 auto;display:flex;flex-wrap:wrap;gap:12px 22px;align-items:center;justify-content:space-between}
#cc p{margin:0;flex:1 1 360px;font-size:.95rem;line-height:1.5}
#cc .acts{display:flex;gap:10px}
#cc button{font:700 .95rem var(--sans);border-radius:99px;padding:10px 22px;cursor:pointer;border:2px solid var(--accent)}
#cc .yes{background:var(--accent);color:#fff}
#cc .no{background:transparent;color:var(--ink)}
:root[data-theme="dark"] #cc .yes,:root:not([data-theme="light"]) #cc .yes{color:#2a1220}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="flower" viewBox="0 0 40 40"><g fill="#f4a6bf"><circle cx="20" cy="9" r="7"/><circle cx="31" cy="17" r="7"/><circle cx="27" cy="30" r="7"/><circle cx="13" cy="30" r="7"/><circle cx="9" cy="17" r="7"/></g><circle cx="20" cy="20" r="5.5" fill="#fbd98a"/></symbol></svg>
<div class="wrap">
<header class="top">
<a class="brand" href="#"><svg aria-hidden="true"><use href="#flower"/></svg>The Little Cup Cafe</a>
<nav aria-label="Main"><a href="#" >Recipes</a><a href="#about">About</a><a href="https://thelittlecupcafe.com">Order &amp; enquire</a><a href="https://www.instagram.com/thelittlecupcafe/">Instagram</a></nav>
</header>
<main id="app"></main>
</div>
<footer><svg aria-hidden="true"><use href="#flower"/></svg>
<ul class="flinks"><li><a href="#about">About</a></li><li><a href="#contact">Contact</a></li><li><a href="#privacy">Privacy policy</a></li><li><button type="button" id="ccopen">Cookie settings</button></li></ul>
<p>&copy; The Little Cup Cafe &middot; Sweet and savoury catering, custom cakes and cheesecakes</p></footer>
<div id="cc" role="dialog" aria-label="Cookie notice" hidden>
<div class="in"><p>We use cookies to show ads and understand how the site is used. You can accept all cookies or choose non-personalised ads only. See our <a href="#privacy">privacy policy</a>.</p>
<div class="acts"><button type="button" class="no" id="ccno">Non-personalised only</button><button type="button" class="yes" id="ccyes">Accept all</button></div></div>
</div>
<script>
var R=[
{id:"blueberry-lemon-cupcakes",tag:"Cupcakes",title:"Pretty in Pink: Fresh, Sweet and Zesty Blueberry and Lemon Cupcakes",short:"Blueberry and Lemon Cupcakes",dek:"Pantry staples, fresh blueberries and lemon. No fake flavouring, no added colours.",hero:"data:image/jpeg;base64,",alt:"Blueberry and lemon cupcakes with pink buttercream on a wooden board",
intro:["Wanting something fresh, zesty and sweet? This is your new go-to bake! With pantry staples, fresh blueberries and lemon, you can’t go wrong.","There’s no fake flavouring and no added colours, and you’ll be sure to please the crowd."],
tip:"The buttercream must be made with real block unsalted butter or it will not work. There is no substitute. If it’s coming up dry or isn’t mixing through fully, add a tablespoon of boiling water to help it warm up and come together.",
name:"Blueberry and Lemon Cupcakes",
ings:[["Cupcakes",["150g unsalted butter, at room temperature","150g caster sugar","3 eggs","150g self-raising flour","Zest of 1 lemon","100g blueberries, washed and rolled through 1 tablespoon of plain flour"]],["Blueberry coulis",["200g blueberries, washed","25g caster sugar","1 tablespoon lemon juice"]],["Buttercream",["200g unsalted butter, at room temperature","400g icing sugar","3–4 tablespoons blueberry coulis"]],["To decorate",["Extra fresh blueberries","A little extra lemon zest"]]],
method:[["",["Preheat the oven to 180°C (160°C fan-forced) and line a 12-hole muffin tray with paper cases.","Cream the butter and sugar together. This is easiest in a bench mixer or with electric beaters. You want it light and fluffy, and the sugar should dissolve into the butter.","Add the eggs, self-raising flour and lemon zest and beat until smooth, about 30 seconds. Be careful not to overmix.","Fold through the blueberries. The flour coating helps stop them sinking to the bottom of the batter.","Spoon the mixture into the cases and bake for 20–22 minutes, or until a skewer comes out clean. Remove from the oven and immediately transfer to a cooling rack to prevent the bases going soggy."]],["Coulis",["While the cupcakes bake, add the blueberries, lemon juice and sugar to a small saucepan over low heat, mashing with a fork until the mixture softens. This will take a few minutes.","Blend until smooth, then pass through a sieve to make sure it’s free of lumps. Leave to cool completely."]],["Buttercream",["Beat the room-temperature butter until smooth. Add the icing sugar and mix until fully incorporated. Slowly add the coulis one spoonful at a time, as you don’t want to soften the buttercream too much."]],["Decorate",["Once the cupcakes are completely cool, it’s time to decorate. Swirl the buttercream on top, drizzle over a spoonful of coulis, then finish with a few fresh blueberries and a sprinkle of lemon zest to really make them stand out."]]],
after:[["Storage","These beauties will keep for 3 days, covered, at room temperature. Remove the fresh berries and they can be refrigerated, covered, for up to a week, or frozen for up to 3 months."],["Make it your own","Why not put your own twist on this recipe and try different flavour combinations with raspberries or strawberries?"]]},
{id:"banana-nutella-swirl-bread",tag:"Baking with kids",title:"Baking with a Toddler: Messy Hands, Big Skills and a Banana Nutella Swirl Bread",short:"Banana Nutella Swirl Bread",dek:"No fancy tools, just a bowl, a fork and a whisk. Made for curious little helpers.",hero:"data:image/jpeg;base64,",alt:"A banana Nutella swirl loaf cut in half to show the chocolate swirl",
intro:["Learning kitchen skills is one of the most valuable things any person can pick up, and we all know how stressful (and messy) a small person in the kitchen can be. But ignore the mess, because it can be cleaned up. Ignore the extra egg that landed on the floor instead of in the bowl, because they’re learning a big skill and loving every minute of it, right up to the first taste of fresh banana Nutella bread.","There are no fancy tools in this bake, just a bowl, a fork and a whisk. It’s the perfect recipe for curious, ready-to-help little hands."],
duo:[["data:image/jpeg;base64,","A toddler’s hands mashing bananas in a glass bowl with a fork"],["data:image/jpeg;base64,","Banana batter swirled with Nutella in a lined loaf tin"]],
name:"Banana Nutella Swirl Bread",
ings:[["",["4 ripe bananas","3 eggs","75g plain yoghurt or sour cream","125g unsalted butter, melted","150g brown sugar","250g self-raising flour","1 tsp baking powder","200g Nutella"]]],
method:[["",["Peel and mash the bananas until smooth. This is the perfect job for little hands with a fork.","Add the eggs and yoghurt and mix until well combined.","Melt the butter and stir in the sugar until dissolved. Add to the banana mixture and combine well.","Mix the flour and baking powder together, then add to the wet ingredients. Mix only until combined. Do not overmix.","Warm the Nutella slightly in the microwave so it’s easy to swirl.","Line a 2lb loaf tin (approximately 23 x 13 cm) with baking paper. Pour in half the banana mixture.","Dollop half the Nutella on top and swirl through with a skewer.","Pour in the remaining banana mixture and repeat with the remaining Nutella, swirling again.","Bake at 180°C (160°C fan-forced) for 60 to 70 minutes, until a skewer comes out clean.","Cover with foil at the 30-minute mark to stop the top browning too much.","Leave the bread in the tin to cool fully before slicing and serving."]]],
after:[["Storage","Keep covered at room temperature for up to 5 days. Alternatively, slice and freeze for up to 3 months, which makes a perfect grab-and-go snack."]]},
{id:"banana-strawberry-swirl-bread",tag:"Baking with kids",title:"Banana and Strawberry Swirl Bread: Toddler Hands and All the Mess",short:"Banana and Strawberry Swirl Bread",dek:"A moist, golden loaf with a ribbon of strawberry jam through the middle.",hero:"data:image/jpeg;base64,",alt:"A banana and strawberry swirl loaf cut in half on a white board",
intro:["This banana bread is made with toddler hands and all the mess! It’s a moist, golden loaf with a ribbon of strawberry jam swirled right through the middle."],
duo:[["data:image/jpeg;base64,","Slices of banana and strawberry swirl bread on a wooden board"]],
tip:"Make sure your jam is thick and real fruit, so it doesn’t add extra liquid to the bread.",
name:"Banana and Strawberry Swirl Bread",
ings:[["Banana bread",["4 ripe bananas","125g butter, softened or melted","150g brown sugar","3 eggs","75g plain yoghurt or sour cream","Vanilla","250g self-raising flour","1 tsp baking powder"]],["Swirl",["5 tablespoons thick, real fruit strawberry jam"]]],
method:[["",["Preheat the oven to 180°C, or 160°C fan forced.","Peel and mash the bananas.","In a separate bowl, cream the softened or melted butter with the sugar until thick and smooth.","Add the eggs, yoghurt, vanilla and mashed bananas and mix through well.","Add the flour and baking powder and fold through until just combined.","Pour half of the mixture into a lined 2lb loaf tin (approximately 21 x 11cm). Swirl through the jam, then top with the remaining banana mixture.","Bake for 30 minutes.","Cover the loaf and bake for a further 30 minutes.","Leave to cool in the tin for 2 hours.","Remove from the tin and leave to cool fully before cutting and serving."]]],
after:[["Storage","Keeps for 5 days covered at room temperature. It can also be sliced and frozen for up to 3 months."],["Make it your own","Experiment with different jam flavours. They’re all going to be amazing with the banana flavour."]]},
{id:"pesto-pumpkin-pasta",tag:"Family dinner",title:"Pesto Pumpkin Pasta: An Easy Meal to Suit the Whole Family",short:"Pesto Pumpkin Pasta",dek:"A toddler favourite that’s on the table in under 30 minutes.",hero:"data:image/jpeg;base64,",alt:"A bowl of strozzapreti pasta with pesto, pancetta and roasted pumpkin",
intro:["This is one of my toddler’s favourites, and it takes no skill at all! The pumpkin and pesto work together to create a sweet yet salty flavour mix the whole family will love.","It’s a meal in under 30 minutes that doesn’t break the bank, and there’s plenty of extra hidden veg thanks to the soffritto mix."],
tip:"I use pancetta, however it isn’t widely available, so feel free to substitute guanciale or, as a last resort, bacon. Alternatively, leave it out and you’ve got a vegetarian version that is just as delicious.",
name:"Pesto Pumpkin Pasta",serves:"This recipe makes 4 adult servings, so you’ll need to adjust it to suit your needs.",
ings:[["Pasta and pumpkin",["500g fresh or dried pasta (I’ve used strozzapreti, but it isn’t widely available outside of Italy, so use what you have on hand or choose a pasta that suits)","300g pumpkin, diced (about 3 handfuls)","Extra virgin olive oil","Salt and pepper"]],["Sauce",["200g pancetta, diced","1 brown onion, diced","1 carrot, diced","1 celery stalk, diced (these three make your soffritto)","2–3 garlic cloves, diced or crushed, or a good tablespoon of jarred garlic (adjust to taste)","1 container of fresh basil pesto, or 3 large tablespoons of jarred pesto, depending on what’s available at your local store","100g Parmesan cheese, grated","100ml thickened or cooking cream (optional, see notes)"]]],
method:[["Pumpkin",["Lay the diced pumpkin on a baking tray, coat with extra virgin olive oil and pepper, and bake for about 20 minutes, or until soft and golden."]],["Pasta",["While the pumpkin is baking, boil a pot of salted water and cook your pasta as per the packet directions. Make your sauce in a separate pan."]],["Sauce",["Heat extra virgin olive oil in a pan over medium heat. Add the pancetta and cook for a few minutes to allow the fat time to render.","Add your soffritto mix along with a good grind of pepper and continue cooking to soften the vegetables and render the pancetta. This will take 5–8 minutes in total. The pancetta fat will render and the pancetta will become crispy (guanciale cooks in a similar time frame, however bacon will cook a lot faster).","Once the pancetta is crispy, add the garlic and stir through for no more than 30 seconds before the next step, as it will burn quickly.","Add your pesto and allow a few minutes for it to become fragrant. This is when you can add the cream, if using, and continue cooking to thicken and reduce while you wait for your pasta. Without cream, set the sauce to the side until your pasta has finished cooking."]],["Serve",["Transfer the pasta straight into the sauce, allowing some pasta water to follow. Stir through the Parmesan and serve with the baked pumpkin on top."]]],
after:[["Storage","This one is best served and eaten straight away."],["Notes","For an even creamier sauce base, stir through 100ml of thickened or cooking cream. Leave out the pancetta for a vegetarian version, and use whatever pasta you have in the pantry."]]}
];
var F='<svg aria-hidden="true"><use href="#flower"/></svg>';
function home(){
var f=R[0];
var h='<section class="hero"><div><h1>Recipes from my kitchen to yours</h1><p>Sweet bakes, easy family dinners and the odd batch made with a very enthusiastic toddler. Real ingredients, honest method and plenty of ways to make each one your own.</p><a class="btn" href="#'+f.id+'">Start with the cupcakes</a></div><div class="heroimg"><svg class="fl a" aria-hidden="true"><use href="#flower"/></svg><svg class="fl b" aria-hidden="true"><use href="#flower"/></svg><div class="arch"><img src="'+f.hero+'" alt="'+f.alt+'"></div></div></section>';
h+='<h2 class="sec">Latest recipes</h2><div class="grid">';
R.forEach(function(r,i){h+='<a class="card" href="#'+r.id+'"><div class="arch"><img src="'+r.hero+'" alt="'+r.alt+'" loading="lazy"></div><span class="tag t'+i+'">'+r.tag+'</span><h3>'+r.short+'</h3><p>'+r.dek+'</p></a>'});
return h+'</div>';
}
function recipe(r){
var h='<article><a class="back" href="#">&larr; All recipes</a><h1>'+r.title+'</h1><p class="by">By Stacey Catlin, The Little Cup Cafe</p><div class="lead"><img src="'+r.hero+'" alt="'+r.alt+'"></div>';
r.intro.forEach(function(p){h+='<p>'+p+'</p>'});
if(r.duo){h+='<div class="duo"'+(r.duo.length<2?' style="grid-template-columns:minmax(0,380px);justify-content:center"':'')+'>'+r.duo.map(function(d){return '<img src="'+d[0]+'" alt="'+d[1]+'" loading="lazy">'}).join('')+'</div>'}
if(r.tip)h+='<div class="tip"><b>Top tip:</b> '+r.tip+'</div>';
h+='<div class="rec"><h2>'+r.name+'</h2>'+(r.serves?'<p class="serves">'+r.serves+'</p>':'')+'<h2 class="sub">Ingredients</h2>';
r.ings.forEach(function(g){if(g[0])h+='<h3>'+g[0]+'</h3>';h+='<ul class="ing">'+g[1].map(function(i){return '<li>'+i+'</li>'}).join('')+'</ul>'});
h+='<h2 class="sub">Method</h2><div class="method">';
r.method.forEach(function(g){if(g[0])h+='<h3>'+g[0]+'</h3>';h+='<ol>'+g[1].map(function(s){return '<li>'+s+'</li>'}).join('')+'</ol>'});
h+='</div>';
r.after.forEach(function(a){h+='<h2 class="sub">'+a[0]+'</h2><p>'+a[1]+'</p>'});
h+='</div><div class="sign">'+F+'<div>Stacey Catlin<small>The Little Cup Cafe</small></div></div></article>';
return h;
}
var PAGES={
about:{title:"About",html:function(){return '<article class="page"><a class="back" href="#">&larr; All recipes</a><h1>About The Little Cup Cafe</h1>'
+'<p>Hi, I’m Stacey. The Little Cup Cafe is my sweet and savoury catering business, specialising in custom cakes, cheesecakes, brownies and blondies, and platters for events big and small.</p>'
+'<p>The business began when I bought a restaurant in 2019. When COVID closed the restaurant, it became a drive-thru coffee service, and today I focus on catering.</p>'
+'<p>This recipe section is where I share the bakes and family meals I make at home, often with a very enthusiastic toddler helping. I use real ingredients, honest methods and quantities in grams, so you can make them in your own kitchen.</p>'
+'<div class="btnrow"><a class="btn" href="https://thelittlecupcafe.com">Order &amp; enquire</a><a class="btn alt" href="#contact">Get in touch</a></div></article>'}},
contact:{title:"Contact",html:function(){return '<article class="page"><a class="back" href="#">&larr; All recipes</a><h1>Contact</h1>'
+'<p>For catering, custom cakes, cheesecakes and event enquiries, please use the order and enquiry page on my main website.</p>'
+'<div class="btnrow"><a class="btn" href="https://thelittlecupcafe.com">Order &amp; enquire</a><a class="btn alt" href="https://www.instagram.com/thelittlecupcafe/">Message on Instagram</a></div>'
+'<p>For questions about a recipe, send me a message on Instagram at <a href="https://www.instagram.com/thelittlecupcafe/">@thelittlecupcafe</a>.</p></article>'}},
privacy:{title:"Privacy policy",html:function(){return '<article class="page"><a class="back" href="#">&larr; All recipes</a><h1>Privacy policy</h1><p class="updated">Last updated 20 November 2026</p>'
+'<p>This policy explains how The Little Cup Cafe (“we”, “us”), a sole trader operating in Australia, handles information on this recipe website.</p>'
+'<h2>What we collect</h2><p>This site has no accounts, comments or sign-up forms, and we do not ask you for personal information here. Like most websites, the services we use may automatically collect technical information such as your IP address, browser type, device and the pages you view.</p>'
+'<h2>Cookies and advertising</h2><p>We use Google AdSense to show ads on this site. Google and its partners use cookies and similar technologies to show ads, including ads based on your previous visits to this or other websites, and to measure how ads perform.</p>'
+'<ul><li>You can choose “Non-personalised only” on our cookie notice, or reopen it any time using “Cookie settings” in the footer.</li>'
+'<li>You can manage personalised advertising at <a href="https://adssettings.google.com">adssettings.google.com</a>.</li>'
+'<li>You can opt out of many third-party advertising cookies at <a href="https://www.aboutads.info">aboutads.info</a>.</li>'
+'<li>You can also block or delete cookies in your browser settings, although some features of websites may not work as expected.</li></ul>'
+'<p>To learn how Google uses information from sites that use its services, visit <a href="https://policies.google.com/technologies/partner-sites">policies.google.com/technologies/partner-sites</a>.</p>'
+'<h2>Other services</h2><p>This site loads fonts from Google Fonts, which means your browser connects to Google to download them. Links to Instagram and to our main website take you to other sites with their own privacy policies. We store your cookie choice in your browser so we can remember it.</p>'
+'<h2>Enquiries</h2><p>If you contact us through Instagram or our main website to make an enquiry or order, we use the details you give us only to respond to you and provide our services.</p>'
+'<h2>Access and complaints</h2><p>You can ask to see, correct or delete personal information we hold about you by contacting us through <a href="https://www.instagram.com/thelittlecupcafe/">Instagram</a> or our <a href="https://thelittlecupcafe.com">main website</a>. In Australia you can also contact the Office of the Australian Information Commissioner at <a href="https://www.oaic.gov.au">oaic.gov.au</a>.</p>'
+'<h2>Changes</h2><p>We may update this policy from time to time. The date at the top shows when it was last changed.</p></article>'}}
};
function route(){
var id=location.hash.slice(1),r=R.filter(function(x){return x.id===id})[0],p=PAGES.hasOwnProperty(id)?PAGES[id]:null;
document.getElementById('app').innerHTML=p?p.html():(r?recipe(r):home());
document.title=(p?p.title:(r?r.short:'Recipes'))+' | The Little Cup Cafe';
window.scrollTo(0,0);
}
window.addEventListener('hashchange',route);route();
(function(){
var cc=document.getElementById('cc');
function get(){try{return localStorage.getItem('tlcc-ads')}catch(e){return null}}
function set(v){try{localStorage.setItem('tlcc-ads',v)}catch(e){}cc.hidden=true}
if(!get())cc.hidden=false;
document.getElementById('ccyes').onclick=function(){set('accepted')};
document.getElementById('ccno').onclick=function(){set('declined');(window.adsbygoogle=window.adsbygoogle||[]).requestNonPersonalizedAds=1};
document.getElementById('ccopen').onclick=function(){cc.hidden=false};
})();
</script>
</body>
</html>
